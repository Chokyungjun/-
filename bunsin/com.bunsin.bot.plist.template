<?xml version="1.0" encoding="UTF-8"?>
<!--
  분신 봇 LaunchAgent (맥미니 24시간 구동용)
  install-mac.sh 가 __DIR__ 를 실제 경로로 바꿔서
  ~/Library/LaunchAgents/com.bunsin.bot.plist 에 깔아준다.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bunsin.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__DIR__/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__DIR__</string>

    <!-- 부팅/로그인 시 자동 실행 + 죽으면 자동 재시작 -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- 로그 -->
    <key>StandardOutPath</key>
    <string>__DIR__/bunsin.log</string>
    <key>StandardErrorPath</key>
    <string>__DIR__/bunsin.error.log</string>
</dict>
</plist>
