# ── 분신 봇 비밀키 ── 이 파일을 복사해서 .env 로 만들고 값을 채워.
# .env 는 절대 깃에 올리지 마 (.gitignore 에 이미 막아둠)

# 텔레그램 @BotFather 에서 봇 만들고 받은 토큰
TELEGRAM_BOT_TOKEN=여기에_봇토큰

# Anthropic API 키 (분신 두뇌값) — console.anthropic.com 에서 발급
ANTHROPIC_API_KEY=여기에_API키

# 너만 봇 쓰게 잠그는 값. 봇에 /start 치면 chat_id 가 나옴 → 그 숫자를 여기 넣어.
# (비워두면 누구나 쓸 수 있으니 꼭 채워)
OWNER_CHAT_ID=

# (선택) 분신 두뇌 모델. 기본 claude-sonnet-4-6.
# 더 깊은 판단 원하면 claude-opus-4-8 로 바꿔 (대신 과금 큼).
BUNSIN_MODEL=claude-sonnet-4-6
